{
  "table": "ItemDisplayInfo",
  "description": "Models, textures and icons for an equippable item. Modern builds moved the component textures into ItemDisplayInfoMaterialRes, so those columns have no source here and come out empty.",
  "id_offset_columns": ["ID"],
  "columns": [
    {"target": ["LeftModel", "ModelName"], "target_array_index": 0,
     "type": "string", "from": "ModelResourcesID", "array_index": 0,
     "transform": "model_path"},
    {"target": ["RightModel", "ModelName"], "target_array_index": 1,
     "type": "string", "from": "ModelResourcesID", "array_index": 1,
     "transform": "model_path"},
    {"target": ["InventoryIcon"], "target_array_index": 0, "type": "string",
     "from": "InventoryIcon", "array_index": 0, "transform": "basename"},
    {"target": ["InventoryIcon"], "target_array_index": 1, "type": "string",
     "from": "InventoryIcon", "array_index": 1, "transform": "basename"}
  ]
}
