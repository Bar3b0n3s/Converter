{
  "table": "CreatureModelData",
  "description": "The model file itself, plus its collision box and scale. Field 2 holds the model path with an .mdx extension, which the 3.3.5a client swaps for .m2 when it opens the file.",
  "target_field_count": 28,
  "id_index": 0,
  "verified": false,
  "columns": [
    {"index": 0,  "type": "uint",   "from": "ID", "id_offset": true},
    {"index": 1,  "type": "uint",   "from": "Flags", "default": 0},
    {"index": 2,  "type": "string", "from": ["FileDataID", "ModelName"],
     "transform": "model_path",
     "note": "3.3.5a needs the .mdx spelling here, not .m2"},
    {"index": 3,  "type": "uint",   "from": "SizeClass", "default": 1},
    {"index": 4,  "type": "float",  "from": "ModelScale", "default": 1.0},
    {"index": 5,  "type": "uint",   "from": "BloodID", "default": 0},
    {"index": 6,  "type": "uint",   "from": "FootprintTextureID", "default": 0},
    {"index": 7,  "type": "float",  "from": "FootprintTextureLength", "default": 0.0},
    {"index": 8,  "type": "float",  "from": "FootprintTextureWidth", "default": 0.0},
    {"index": 9,  "type": "float",  "from": "FootprintParticleScale", "default": 0.0},
    {"index": 10, "type": "uint",   "from": "FoleyMaterialID", "default": 0},
    {"index": 11, "type": "uint",   "from": ["FootstepCameraEffectID", "FootstepShakeSize"],
     "default": 0},
    {"index": 12, "type": "uint",   "from": ["DeathThudCameraEffectID", "DeathThudShakeSize"],
     "default": 0},
    {"index": 13, "type": "uint",   "from": "SoundID", "default": 0},
    {"index": 14, "type": "float",  "from": "CollisionWidth", "default": 1.0},
    {"index": 15, "type": "float",  "from": "CollisionHeight", "default": 2.0},
    {"index": 16, "type": "float",  "from": ["MountHeight", "HoverHeight"], "default": 0.0},
    {"index": 17, "type": "float",  "from": "GeoBoxMin", "array_index": 0, "default": -1.0},
    {"index": 18, "type": "float",  "from": "GeoBoxMin", "array_index": 1, "default": -1.0},
    {"index": 19, "type": "float",  "from": "GeoBoxMin", "array_index": 2, "default": 0.0},
    {"index": 20, "type": "float",  "from": "GeoBoxMax", "array_index": 0, "default": 1.0},
    {"index": 21, "type": "float",  "from": "GeoBoxMax", "array_index": 1, "default": 1.0},
    {"index": 22, "type": "float",  "from": "GeoBoxMax", "array_index": 2, "default": 2.0},
    {"index": 23, "type": "float",  "from": "WorldEffectScale", "default": 1.0},
    {"index": 24, "type": "float",  "from": "AttachedEffectScale", "default": 1.0},
    {"index": 25, "type": "float",  "from": "MissileCollisionRadius", "default": 0.0},
    {"index": 26, "type": "float",  "from": "MissileCollisionPush", "default": 0.0},
    {"index": 27, "type": "float",  "from": "MissileCollisionRaise", "default": 0.0}
  ]
}
